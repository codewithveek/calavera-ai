{
  "expo": {
    "name": "Calavera AI",
    "slug": "calavera-ai",
    "scheme": "calavera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#120D1A",
    "android": {
      "package": "dev.calavera.ai",
      "adaptiveIcon": {
        "backgroundColor": "#120D1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#120D1A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-sqlite",
        {
          "withSQLiteVecExtension": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Calavera AI uses the camera to identify heirlooms for your ofrenda. Photos never leave your phone.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Calavera AI lets you pick a photo of an heirloom to place on your ofrenda.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Calavera AI saves your tribute cards to your gallery.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.rnllama.** { *; }"
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      "./plugins/withWindowsNativeBuild"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
